# AlphaClone System OS - Git Ignore Rules
# Purpose: Prevent build artifacts and transient files from entering version control.
# Author: AlphaClone Systems Core Team
# License: MIT
# TODO: Revisit ignore list as new tooling and platforms are introduced.

# Build outputs
build/
.iso/
*.iso
*.bin

# Object files
*.o
*.obj
*.elf

# Logs and traces
*.log
logs/

# Node dependencies
node_modules/
.pnpm-store/

# Editor state
.DS_Store
.idea/
*.swp
