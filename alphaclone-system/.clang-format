# AlphaClone System OS - ClangFormat Configuration
# Purpose: Standardize formatting for C source files across the project.
# Author: AlphaClone Systems Core Team
# License: MIT
# TODO: Tune brace styles once subsystem maintainers align on conventions.

BasedOnStyle: LLVM
IndentWidth: 4
ColumnLimit: 100
UseTab: Never
AllowShortIfStatementsOnASingleLine: false
BreakBeforeBraces: Linux
