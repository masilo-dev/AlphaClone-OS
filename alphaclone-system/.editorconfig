# AlphaClone System OS - Editor Configuration
# Purpose: Enforce consistent whitespace and encoding rules across the project.
# Author: AlphaClone Systems Core Team
# License: MIT
# TODO: Extend with language-specific overrides as subsystems grow.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.ts]
indent_size = 2

[Makefile]
indent_style = tab
